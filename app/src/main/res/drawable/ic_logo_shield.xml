<?xml version="1.0" encoding="utf-8"?>
<!-- Logo recréé en vecteur (bouclier + D) : remplaçable par le fichier
     original du client sans toucher à l'UI (même nom de ressource). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="40dp"
    android:height="40dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Bouclier extérieur : dégradé cyan -> bleu (bordure lumineuse) -->
    <path android:pathData="M12,1.5 L21,5v6.2c0,5.5 -4,9.8 -9,11.8c-5,-2 -9,-6.3 -9,-11.8V5Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="3"
                android:startY="2"
                android:endX="21"
                android:endY="22">
                <item android:offset="0" android:color="#FF67E8F9" />
                <item android:offset="1" android:color="#FF2D6BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bouclier intérieur (fond marine sombre) -->
    <path
        android:fillColor="#FF071531"
        android:pathData="M12,3.6 L18.8,6.3v4.9c0,4.3 -3.1,7.9 -6.8,9.7c-3.7,-1.8 -6.8,-5.4 -6.8,-9.7v-4.9Z" />

    <!-- Lettre D centrée -->
    <path
        android:fillColor="#FFF4FBFF"
        android:fillType="evenOdd"
        android:pathData="M9.1,7.1h3.2a4.9,4.9 0 0 1 0,9.8h-3.2z M10.8,8.8v6.4h1.3a3.2,3.2 0 0 0 0,-6.4z" />
</vector>
